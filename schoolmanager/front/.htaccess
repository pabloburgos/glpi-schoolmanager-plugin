<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^formularios\.php$ dashboard.php [L,QSA]
    RewriteRule ^nueva_incidencia\.php$ new_ticket.php [L,QSA]
    RewriteRule ^nueva-incidencia\.php$ new_ticket.php [L,QSA]
    RewriteRule ^mis_solicitudes\.php$ my_requests.php [L,QSA]
    RewriteRule ^solicitud_detalle\.php$ ticket_detail.php [L,QSA]
    RewriteRule ^avisos\.php$ notifications.php [L,QSA]
    RewriteRule ^aulas\.php$ classrooms.php [L,QSA]
    RewriteRule ^detalle_aula\.php$ classroom_detail.php [L,QSA]
    RewriteRule ^assets_aula\.php$ classroom_assets.php [L,QSA]
    RewriteRule ^nuevo_activo\.php$ new_asset.php [L,QSA]
    RewriteRule ^nuevo-activo\.php$ new_asset.php [L,QSA]
    RewriteRule ^gestion_activos\.php$ asset_management.php [L,QSA]
    RewriteRule ^editar_activo\.php$ edit_asset.php [L,QSA]
    RewriteRule ^nuevo_ordenador\.php$ new_computer.php [L,QSA]
    RewriteRule ^panel_tic\.php$ it_panel.php [L,QSA]
    RewriteRule ^asignaciones_tic\.php$ it_assignments.php [L,QSA]
    RewriteRule ^tecnico_resumen\.php$ technician_summary.php [L,QSA]
    RewriteRule ^stock_glpi\.php$ stock.php [L,QSA]
    RewriteRule ^stock_movimiento\.php$ stock_movement.php [L,QSA]
    RewriteRule ^configuracion\.php$ settings.php [L,QSA]
    RewriteRule ^instalacion\.php$ install.php [L,QSA]
    RewriteRule ^creditos\.php$ credits.php [L,QSA]
    RewriteRule ^versiones\.php$ versions.php [L,QSA]
    RewriteRule ^archivos\.php$ file_editor.php [L,QSA]
    RewriteRule ^mapa\.php$ map.php [L,QSA]
    RewriteRule ^mapa_calor\.php$ heatmap.php [L,QSA]
</IfModule>
